{
  "name": "lucas-command-center",
  "version": "1.0.0",
  "description": "Lucas Initiative - Claude Code Session Orchestration Platform",
  "type": "module",
  "scripts": {
    "daemon": "tsx server/daemon/index.ts",
    "dev": "tsx watch server/index.ts",
    "build": "cd frontend && npm run build",
    "start": "node --loader tsx server/index.ts",
    "setup": "npm install && cd frontend && npm install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "node-pty": "^1.0.0",
    "node-telegram-bot-api": "^0.67.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/node-telegram-bot-api": "^0.64.14",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
